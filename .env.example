# Site URL and base path (set automatically in CI for Vercel)
# ASTRO_SITE=https://www.kedma.xyz
# ASTRO_BASE=/

# Google Analytics 4 measurement ID (https://analytics.google.com)
# See docs/google-analytics-setup.md
PUBLIC_GA_MEASUREMENT_ID=G-14BQQ9TGBK

# Clerk authentication (https://dashboard.clerk.com)
# For local dev, pull development keys with: clerk env pull
# Production keys (pk_live_ / sk_live_) only work on your production domain.
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Local episode publisher only (`npm run publish-episode`) — never needed in CI/Vercel
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=kedma-audio
# R2_PUBLIC_BASE_URL=https://audio.kedma.xyz
# PUBLISH_DRY_RUN=1
# PUBLISH_PORT=8787
