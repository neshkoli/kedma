---
import { formatEpisodeDuration } from '@/lib/episodes';
import { Show } from '@clerk/astro/components';

interface Props {
  src: string;
  title: string;
  /** RSS duration (HH:MM:SS), shown before metadata loads to avoid a layout shift. */
  duration?: string;
  /** Episode slug for analytics (e.g. 2025/12/75.html). */
  episodeSlug?: string;
}

const { src, title, duration, episodeSlug } = Astro.props;
const filename = src.split('/').pop() ?? 'episode';
const initialTotal = duration ? formatEpisodeDuration(duration) : '--:--';
---

<div
  class="audio-bar"
  data-audio-player
  data-storage-key={src}
  data-episode-slug={episodeSlug}
  data-episode-title={title}
  data-audio-url={src}
>
  <audio id="episode-audio" preload="metadata" src={src} title={title}>
    הדפדפן שלך לא תומך בנגן אודיו.
  </audio>

  <p class="audio-resume-toast" data-resume-toast hidden>המשך מהמקום שבו הפסקת</p>

  <div
    class="audio-seek"
    dir="ltr"
    role="slider"
    tabindex="0"
    aria-label="מיקום בפרק"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
    aria-valuetext="0:00"
    data-seek
  >
    <div class="audio-seek-track">
      <div class="audio-seek-buffered" data-buffered></div>
      <div class="audio-seek-played" data-played></div>
    </div>
    <div class="audio-seek-thumb" data-thumb></div>
  </div>

  <div class="page-container flex items-center gap-1 py-2.5 sm:gap-2">
    <button type="button" class="audio-btn-play" data-toggle aria-label="נגן">
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-icon-play>
        <path d="M8 5.5v13l11-6.5z"></path>
      </svg>
      <svg
        class="hidden h-6 w-6"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
        data-icon-pause
      >
        <rect x="7" y="5.5" width="3.5" height="13" rx="1"></rect>
        <rect x="13.5" y="5.5" width="3.5" height="13" rx="1"></rect>
      </svg>
    </button>

    <button type="button" class="audio-btn audio-btn-skip" data-skip="-15" aria-label="אחורה 15 שניות">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M11.5 5.5a7.5 7.5 0 1 1-7.36 9" stroke-linecap="round"></path>
        <path d="M8.4 2.6 4.1 5.7l3.1 3.5" stroke-linecap="round" stroke-linejoin="round"></path>
        <text
          x="12.5"
          y="17.4"
          text-anchor="middle"
          font-size="7.5"
          font-weight="600"
          fill="currentColor"
          stroke="none">15</text
        >
      </svg>
    </button>

    <button type="button" class="audio-btn audio-btn-skip" data-skip="15" aria-label="קדימה 15 שניות">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M12.5 5.5a7.5 7.5 0 1 0 7.36 9" stroke-linecap="round"></path>
        <path d="M15.6 2.6 19.9 5.7l-3.1 3.5" stroke-linecap="round" stroke-linejoin="round"></path>
        <text
          x="11.5"
          y="17.4"
          text-anchor="middle"
          font-size="7.5"
          font-weight="600"
          fill="currentColor"
          stroke="none">15</text
        >
      </svg>
    </button>

    <p class="audio-time" dir="ltr">
      <span data-elapsed>0:00</span>
      <span class="audio-time-total"
        ><span class="audio-time-sep">/</span> <span data-total>{initialTotal}</span></span
      >
    </p>

    <div class="flex-1"></div>

    <button
      type="button"
      class="audio-btn audio-btn-rate"
      data-rate
      aria-label="מהירות ניגון"
      title="מהירות ניגון"
    >
      <span dir="ltr" data-rate-label>1&#215;</span>
    </button>

    <div class="audio-volume">
      <button type="button" class="audio-btn" data-mute aria-label="השתקה">
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          data-icon-sound
        >
          <path d="M11 5 6.5 9H3.5v6h3L11 19z"></path>
          <path d="M15 9.5a3.5 3.5 0 0 1 0 5"></path>
          <path d="M17.8 7a7 7 0 0 1 0 10"></path>
        </svg>
        <svg
          class="hidden h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          data-icon-muted
        >
          <path d="M11 5 6.5 9H3.5v6h3L11 19z"></path>
          <path d="m15.5 10 5 5"></path>
          <path d="m20.5 10-5 5"></path>
        </svg>
      </button>
      <input
        type="range"
        class="audio-volume-slider"
        dir="ltr"
        min="0"
        max="1"
        step="0.05"
        value="1"
        aria-label="עוצמת שמע"
        data-volume
      />
    </div>

    <Show when="signed-in">
      <a
        href={src}
        download={filename}
        class="audio-btn"
        data-download-link
        aria-label="הורדה"
        title="הורדה"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3v12"></path>
          <path d="M7 10l5 5 5-5"></path>
          <path d="M5 21h14"></path>
        </svg>
      </a>
    </Show>
  </div>
</div>

<script>
  const RATES = [1, 1.25, 1.5, 1.75, 2];
  const RATE_KEY = 'kedma:rate';
  const SKIP_KEY_STEP = 5;

  function readStore(key: string): string | null {
    try {
      return window.localStorage.getItem(key);
    } catch {
      return null;
    }
  }

  function writeStore(key: string, value: string) {
    try {
      window.localStorage.setItem(key, value);
    } catch {
      /* storage unavailable (private mode, quota) — resume is best-effort */
    }
  }

  function clearStore(key: string) {
    try {
      window.localStorage.removeItem(key);
    } catch {
      /* see writeStore */
    }
  }

  function formatTime(seconds: number): string {
    if (!Number.isFinite(seconds) || seconds < 0) return '0:00';
    const total = Math.floor(seconds);
    const hours = Math.floor(total / 3600);
    const minutes = Math.floor((total % 3600) / 60);
    const secs = total % 60;
    const pad = (value: number) => String(value).padStart(2, '0');
    return hours > 0 ? `${hours}:${pad(minutes)}:${pad(secs)}` : `${minutes}:${pad(secs)}`;
  }

  function initAudioPlayer() {
    const root = document.querySelector<HTMLElement>('[data-audio-player]');
    if (!root || root.dataset.audioInit) return;

    const audio = root.querySelector<HTMLAudioElement>('audio');
    const seek = root.querySelector<HTMLElement>('[data-seek]');
    const played = root.querySelector<HTMLElement>('[data-played]');
    const buffered = root.querySelector<HTMLElement>('[data-buffered]');
    const thumb = root.querySelector<HTMLElement>('[data-thumb]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]');
    const iconPlay = root.querySelector<HTMLElement>('[data-icon-play]');
    const iconPause = root.querySelector<HTMLElement>('[data-icon-pause]');
    const elapsedLabel = root.querySelector<HTMLElement>('[data-elapsed]');
    const totalLabel = root.querySelector<HTMLElement>('[data-total]');
    const rateButton = root.querySelector<HTMLButtonElement>('[data-rate]');
    const rateLabel = root.querySelector<HTMLElement>('[data-rate-label]');
    const muteButton = root.querySelector<HTMLButtonElement>('[data-mute]');
    const iconSound = root.querySelector<HTMLElement>('[data-icon-sound]');
    const iconMuted = root.querySelector<HTMLElement>('[data-icon-muted]');
    const volume = root.querySelector<HTMLInputElement>('[data-volume]');
    if (!audio || !seek || !played || !buffered || !thumb || !toggle) return;
    if (!iconPlay || !iconPause || !elapsedLabel || !totalLabel) return;

    root.dataset.audioInit = 'true';

    function episodeAnalyticsDetail(extra: Record<string, string | number | undefined> = {}) {
      const audioUrl = root.dataset.audioUrl || audio.currentSrc || undefined;
      return {
        episode_slug: root.dataset.episodeSlug || undefined,
        episode_title: root.dataset.episodeTitle || undefined,
        audio_url: audioUrl,
        audio_host: audioUrl ? 'audio.kedma.xyz' : undefined,
        ...extra,
      };
    }

    function dispatchAnalytics(eventName: string, extra: Record<string, string | number | undefined> = {}) {
      window.dispatchEvent(
        new CustomEvent(eventName, { detail: episodeAnalyticsDetail(extra) }),
      );
    }

    function trackListenProgress() {
      if (!Number.isFinite(audio.duration) || audio.duration <= 0) return;
      const percent = Math.floor((audio.currentTime / audio.duration) * 100);
      for (const milestone of [25, 50, 75, 100]) {
        if (percent >= milestone && !progressMilestones.has(milestone)) {
          progressMilestones.add(milestone);
          dispatchAnalytics('kedma:audio_progress', { percent_listened: milestone });
        }
      }
    }

    function trackListenTime() {
      if (listenStartedAt === null) return;
      const seconds = Math.round((performance.now() - listenStartedAt) / 1000);
      listenStartedAt = null;
      if (seconds > 0) {
        dispatchAnalytics('kedma:audio_listen_time', { listen_seconds: seconds });
      }
    }

    const positionKey = `kedma:pos:${root.dataset.storageKey ?? audio.currentSrc}`;
    let dragging = false;
    let restored = false;
    let hasTrackedPlay = false;
    const progressMilestones = new Set<number>();
    let listenStartedAt: number | null = null;
    const resumeToast = root.querySelector<HTMLElement>('[data-resume-toast]');
    let resumeToastTimer: ReturnType<typeof setTimeout> | undefined;

    function showResumeToast() {
      if (!resumeToast) return;
      resumeToast.hidden = false;
      resumeToast.classList.add('is-visible');
      if (resumeToastTimer) clearTimeout(resumeToastTimer);
      resumeToastTimer = setTimeout(() => {
        resumeToast.classList.remove('is-visible');
        resumeToast.hidden = true;
      }, 4000);
    }

    function setProgressUi(current: number, total: number) {
      const ratio = total > 0 ? Math.min(Math.max(current / total, 0), 1) : 0;
      const percent = `${(ratio * 100).toFixed(3)}%`;
      played!.style.width = percent;
      thumb!.style.left = percent;
      elapsedLabel!.textContent = formatTime(current);
      seek!.setAttribute('aria-valuenow', String(Math.round(ratio * 100)));
      seek!.setAttribute(
        'aria-valuetext',
        total > 0 ? `${formatTime(current)} מתוך ${formatTime(total)}` : formatTime(current),
      );
    }

    function seekToClientX(clientX: number) {
      const rect = seek!.getBoundingClientRect();
      if (rect.width <= 0 || !Number.isFinite(audio!.duration)) return;
      const ratio = Math.min(Math.max((clientX - rect.left) / rect.width, 0), 1);
      audio!.currentTime = ratio * audio!.duration;
      setProgressUi(audio!.currentTime, audio!.duration);
    }

    function nudge(delta: number) {
      if (!Number.isFinite(audio!.duration)) return;
      audio!.currentTime = Math.min(Math.max(audio!.currentTime + delta, 0), audio!.duration);
      setProgressUi(audio!.currentTime, audio!.duration);
    }

    function applyRate(rate: number) {
      audio!.playbackRate = rate;
      if (rateLabel) rateLabel.textContent = `${rate}\u00d7`;
      rateButton?.setAttribute('aria-label', `מהירות ניגון: ${rate} — לחצו להחלפה`);
    }

    function syncMuteUi() {
      const silent = audio!.muted || audio!.volume === 0;
      iconSound?.classList.toggle('hidden', silent);
      iconMuted?.classList.toggle('hidden', !silent);
      muteButton?.setAttribute('aria-label', silent ? 'ביטול השתקה' : 'השתקה');
    }

    // --- transport ---

    toggle.addEventListener('click', () => {
      if (audio.paused) void audio.play();
      else audio.pause();
    });

    root.querySelectorAll<HTMLButtonElement>('[data-skip]').forEach((button) => {
      button.addEventListener('click', () => nudge(Number(button.dataset.skip)));
    });

    rateButton?.addEventListener('click', () => {
      const next = RATES[(RATES.indexOf(audio.playbackRate) + 1) % RATES.length] ?? 1;
      applyRate(next);
      writeStore(RATE_KEY, String(next));
    });

    muteButton?.addEventListener('click', () => {
      audio.muted = !audio.muted;
      if (!audio.muted && audio.volume === 0) audio.volume = 1;
      syncMuteUi();
      if (volume) volume.value = String(audio.muted ? 0 : audio.volume);
    });

    volume?.addEventListener('input', () => {
      audio.volume = Number(volume.value);
      audio.muted = audio.volume === 0;
      syncMuteUi();
    });

    // --- seeking ---

    seek.addEventListener('pointerdown', (event) => {
      dragging = true;
      seek.setPointerCapture(event.pointerId);
      seek.classList.add('is-scrubbing');
      seekToClientX(event.clientX);
    });

    seek.addEventListener('pointermove', (event) => {
      if (dragging) seekToClientX(event.clientX);
    });

    const endDrag = (event: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      seek.classList.remove('is-scrubbing');
      if (seek.hasPointerCapture(event.pointerId)) seek.releasePointerCapture(event.pointerId);
    };

    seek.addEventListener('pointerup', endDrag);
    seek.addEventListener('pointercancel', endDrag);

    seek.addEventListener('keydown', (event) => {
      switch (event.key) {
        case 'ArrowRight':
          nudge(SKIP_KEY_STEP);
          break;
        case 'ArrowLeft':
          nudge(-SKIP_KEY_STEP);
          break;
        case 'PageUp':
          nudge(30);
          break;
        case 'PageDown':
          nudge(-30);
          break;
        case 'Home':
          audio.currentTime = 0;
          break;
        case 'End':
          if (Number.isFinite(audio.duration)) audio.currentTime = audio.duration;
          break;
        case ' ':
        case 'Enter':
          if (audio.paused) void audio.play();
          else audio.pause();
          break;
        default:
          return;
      }
      event.preventDefault();
    });

    // --- audio element state ---

    audio.addEventListener('loadedmetadata', () => {
      totalLabel.textContent = formatTime(audio.duration);
      if (!restored) {
        restored = true;
        const saved = Number(readStore(positionKey));
        // Only resume from a spot worth returning to, and never from the tail end.
        if (Number.isFinite(saved) && saved > 10 && saved < audio.duration - 15) {
          audio.currentTime = saved;
          showResumeToast();
        }
      }
      setProgressUi(audio.currentTime, audio.duration);
    });

    audio.addEventListener('timeupdate', () => {
      if (!dragging) setProgressUi(audio.currentTime, audio.duration);
      if (audio.currentTime > 10) writeStore(positionKey, audio.currentTime.toFixed(1));
      if (!audio.paused) trackListenProgress();
    });

    audio.addEventListener('progress', () => {
      if (audio.buffered.length === 0 || !Number.isFinite(audio.duration)) return;
      const end = audio.buffered.end(audio.buffered.length - 1);
      buffered.style.width = `${Math.min((end / audio.duration) * 100, 100).toFixed(3)}%`;
    });

    audio.addEventListener('play', () => {
      root.classList.add('is-playing');
      iconPlay.classList.add('hidden');
      iconPause.classList.remove('hidden');
      toggle.setAttribute('aria-label', 'השהה');
      listenStartedAt = performance.now();
      if (!hasTrackedPlay) {
        hasTrackedPlay = true;
        dispatchAnalytics('kedma:audio_play');
      }
    });

    audio.addEventListener('pause', () => {
      root.classList.remove('is-playing');
      iconPlay.classList.remove('hidden');
      iconPause.classList.add('hidden');
      toggle.setAttribute('aria-label', 'נגן');
      if (audio.ended) return;
      trackListenTime();
      dispatchAnalytics('kedma:audio_pause');
    });

    audio.addEventListener('ended', () => {
      clearStore(positionKey);
      trackListenTime();
      dispatchAnalytics('kedma:audio_complete');
    });

    root.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const link = target.closest('[data-download-link]');
      if (!link) return;
      dispatchAnalytics('kedma:file_download');
    });

    const savedRate = Number(readStore(RATE_KEY));
    applyRate(RATES.includes(savedRate) ? savedRate : 1);
    syncMuteUi();
  }

  initAudioPlayer();
  document.addEventListener('astro:page-load', initAudioPlayer);
</script>
