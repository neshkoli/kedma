---
import EpisodeDateDuration from '@/components/EpisodeDateDuration.astro';
import { episodeUrl, episodeSnippet, formatEpisodeDuration, type Episode } from '@/lib/episodes';
import { withBase } from '@/lib/paths';

interface Props {
  episode: Episode;
}

const { episode } = Astro.props;
const { title, date, image, periodName, duration, audioUrl } = episode.data;
const { text: snippet } = episodeSnippet(episode);
const url = episodeUrl(episode);
const durationLabel = duration ? formatEpisodeDuration(duration) : null;
---

<section class="border-b border-outline-variant bg-surface-container-low/50">
  <div class="page-container py-10 md:py-12">
    <div class="flex flex-col items-stretch gap-8 md:flex-row md:items-start md:gap-12">
      {
        image && (
          <a
            href={url}
            class="group aspect-square w-full shrink-0 self-start overflow-hidden manuscript-border md:w-2/5 lg:w-1/3"
            aria-label={title}
          >
            <img
              src={withBase(image)}
              alt=""
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
          </a>
        )
      }
      <div class="flex flex-1 flex-col justify-center">
        <span class="mb-2 flex items-center gap-2 font-body text-label-sm font-bold text-secondary">
          <span class="inline-block h-0.5 w-5 bg-aged-gold" aria-hidden="true"></span>
          הפרק האחרון
        </span>
        <h2 class="card-title-lg mb-3">
          <a href={url} class="transition-colors duration-300 hover:text-secondary">
            {title}
          </a>
        </h2>
        <EpisodeDateDuration
          date={date}
          duration={duration}
          class="mb-3"
          textClass="font-body text-body-md text-on-surface-variant"
        />
        {periodName && <span class="badge-period">{periodName}</span>}
        {
          snippet && (
            <p class="mt-4 break-words font-body text-body-lg leading-[1.67] text-on-surface-variant">
              {snippet}
            </p>
          )
        }
        <div class="mt-6 flex flex-wrap items-center gap-4">
          {
            audioUrl && (
              <a href={url} class="episode-play-btn" aria-label="האזינו עכשיו">
                <span class="episode-play-btn-icon" aria-hidden="true">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5.5v13l11-6.5z"></path>
                  </svg>
                </span>
                <span>האזינו עכשיו</span>
                {
                  durationLabel && (
                    <span class="episode-play-btn-duration" dir="ltr">
                      {durationLabel}
                    </span>
                  )
                }
              </a>
            )
          }
          <a
            href={url}
            class="font-body text-label-lg font-bold text-ink-blue underline-offset-4 transition-colors hover:text-secondary hover:underline hover:decoration-aged-gold"
          >
            לעמוד הפרק
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
