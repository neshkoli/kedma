---
import { Show, SignInButton, UserButton } from '@clerk/astro/components';
---

<div class="flex items-center">
  <Show when="signed-out">
    <SignInButton mode="modal" asChild>
      <button
        type="button"
        class="rounded-full p-2 text-ink-blue transition-colors hover:bg-surface-container-high"
        aria-label="התחברות"
        title="התחברות"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 21a8 8 0 0 0-16 0"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </button>
    </SignInButton>
  </Show>

  <Show when="signed-in">
    <UserButton
      appearance={{
        elements: {
          avatarBox: 'h-9 w-9',
        },
      }}
    />
  </Show>
</div>
