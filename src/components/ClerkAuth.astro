---
import { SignInButton, UserButton } from '@clerk/astro/components';
---

<div class="flex items-center" data-clerk-auth>
  <div data-clerk-signed-out>
    <SignInButton mode="modal" asChild>
      <button
        type="button"
        class="rounded-full p-1.5 text-ink-blue transition-colors hover:bg-surface-container-high md:p-2"
        aria-label="התחברות"
        title="התחברות"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 21a8 8 0 0 0-16 0"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </button>
    </SignInButton>
  </div>

  <div class="hidden" data-clerk-signed-in>
    <UserButton
      appearance={{
        elements: {
          avatarBox: 'h-8 w-8',
        },
      }}
    />
  </div>
</div>

<script>
  import { $authStore, $isLoadedStore } from '@clerk/astro/client';

  function syncClerkAuth(root: Element) {
    if (root.hasAttribute('data-clerk-auth-init')) return;

    const signedOut = root.querySelector('[data-clerk-signed-out]');
    const signedIn = root.querySelector('[data-clerk-signed-in]');
    if (!(signedOut instanceof HTMLElement) || !(signedIn instanceof HTMLElement)) return;

    root.setAttribute('data-clerk-auth-init', 'true');

    const update = () => {
      const userId = $authStore.get()?.userId;
      const loaded = $isLoadedStore.get();

      if (!loaded || !userId) {
        signedOut.classList.remove('hidden');
        signedIn.classList.add('hidden');
        return;
      }

      signedOut.classList.add('hidden');
      signedIn.classList.remove('hidden');
    };

    $isLoadedStore.subscribe(update);
    $authStore.subscribe(update);
    update();
  }

  function initClerkAuth() {
    document.querySelectorAll('[data-clerk-auth]').forEach(syncClerkAuth);
  }

  initClerkAuth();
  document.addEventListener('astro:page-load', initClerkAuth);
</script>
