---
interface Props {
  pageId: string;
  pageUrl: string;
  pageTitle: string;
  appId?: string;
}

const { pageId, pageUrl, pageTitle, appId = import.meta.env.PUBLIC_CUSDIS_APP_ID } = Astro.props;
---

{appId ? (
  <section class="mt-12 border-t border-outline-variant/60 pt-8">
    <h2 class="section-title mb-4">תגובות</h2>
    <div class="cusdis-wrap">
      <div
        id="cusdis_thread"
        data-host="https://cusdis.com"
        data-app-id={appId}
        data-page-id={pageId}
        data-page-url={pageUrl}
        data-page-title={pageTitle}
        data-lang="he"
        data-theme="light"
      />
    </div>
    <script is:inline src="https://cusdis.com/js/cusdis.es.js" async defer />
    <script is:inline>
      (function initCusdisTheme() {
        const thread = document.getElementById('cusdis_thread');
        if (!thread || thread.dataset.themeInit) return;
        thread.dataset.themeInit = 'true';

        const root = getComputedStyle(document.documentElement);
        const colors = {
          background: root.getPropertyValue('--kedma-background').trim() || '#fcf9ef',
          foreground: root.getPropertyValue('--kedma-foreground').trim() || '#1c1c16',
          muted: root.getPropertyValue('--kedma-muted').trim() || '#45474d',
          accent: root.getPropertyValue('--kedma-accent').trim() || '#775a19',
          border: root.getPropertyValue('--kedma-border').trim() || '#c5c6cd',
          surface: root.getPropertyValue('--kedma-surface').trim() || '#f1eee4',
          primary: root.getPropertyValue('--kedma-primary').trim() || '#1b263b',
        };

        const css = `
          body, #root { background: ${colors.background} !important; color: ${colors.foreground} !important; }
          textarea, input { background: #ffffff !important; border-color: ${colors.border} !important; color: ${colors.foreground} !important; }
          button[type="submit"] { background: ${colors.primary} !important; color: ${colors.background} !important; border: none !important; }
          a { color: ${colors.accent} !important; }
          .text-gray-500, .text-gray-600 { color: ${colors.muted} !important; }
        `;

        function inject(iframe) {
          try {
            const doc = iframe.contentDocument || iframe.contentWindow?.document;
            if (!doc?.head || doc.getElementById('kedma-cusdis-theme')) return;
            const style = doc.createElement('style');
            style.id = 'kedma-cusdis-theme';
            style.textContent = css;
            doc.head.appendChild(style);
          } catch {
            /* cross-origin guard — Cusdis iframe is same-origin when loaded */
          }
        }

        const observer = new MutationObserver((mutations) => {
          for (const mutation of mutations) {
            for (const node of mutation.addedNodes) {
              if (node instanceof HTMLIFrameElement) inject(node);
            }
          }
        });

        observer.observe(thread, { childList: true, subtree: true });
        thread.querySelectorAll('iframe').forEach(inject);
      })();
    </script>
  </section>
) : (
  <section class="mt-12 rounded border border-dashed border-outline-variant p-6 text-center text-on-surface-variant">
    <p>תגובות יופעלו לאחר הגדרת Cusdis.</p>
  </section>
)}
