---
import { withBase } from '@/lib/paths';
import ClerkAuth from '@/components/ClerkAuth.astro';

interface Props {
  current?: 'home' | 'episodes' | 'periods' | 'search' | 'listen';
}

const { current = 'home' } = Astro.props;

type NavItem =
  | { id: NonNullable<Props['current']>; href: string; label: string }
  | { href: string; label: string; external: true };

const nav: NavItem[] = [
  { id: 'home', href: withBase(''), label: 'בית' },
  { id: 'episodes', href: withBase('episodes.html'), label: 'פרקים' },
  { id: 'periods', href: withBase('periods.html'), label: 'תקופות' },
  { id: 'listen', href: withBase('how-to-listen.html'), label: 'כיצד להאזין' },
  { href: 'https://t.me/kedmachat', label: 'טלגרם', external: true },
];
---

<nav class="border-b border-outline-variant bg-parchment-base/95 backdrop-blur-md">
  <div class="page-container flex items-center justify-between gap-4 py-3">
    <div class="flex min-w-0 items-center gap-4 sm:gap-6">
      {
        nav.map((item) => {
          const isExternal = 'external' in item;
          const isCurrent = !isExternal && current === item.id;

          return (
            <a
              href={item.href}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener noreferrer' : undefined}
              class:list={[
                'font-body text-label-lg font-semibold transition-colors duration-300',
                isCurrent
                  ? 'border-b-2 border-aged-gold pb-1 font-bold text-secondary'
                  : 'text-on-surface-variant hover:text-secondary',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }

      <a
        href={withBase('search.html')}
        class:list={[
          'rounded-full p-2 text-ink-blue transition-colors hover:bg-surface-container-high',
          current === 'search' && 'bg-surface-container-high',
        ]}
        aria-label="חיפוש"
        aria-current={current === 'search' ? 'page' : undefined}
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3.5-3.5"></path>
        </svg>
      </a>
    </div>

    <ClerkAuth />
  </div>
</nav>
