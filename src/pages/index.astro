---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeHeader from '@/components/HomeHeader.astro';
import LatestEpisodeSpotlight from '@/components/LatestEpisodeSpotlight.astro';
import EpisodeArchiveCard from '@/components/EpisodeArchiveCard.astro';
import { archiveCardVariant, getEpisodes } from '@/lib/episodes';

const episodes = await getEpisodes();
const [latest, ...rest] = episodes;
---

<BaseLayout
  title="קדמא"
  description="קדמא - פודקאסט על אנשים וארועים בהיסטוריה היהודית עם נעם אשכולי"
>
  <HomeHeader current="home" />

  <main>
    {latest && <LatestEpisodeSpotlight episode={latest} />}

    <section id="archive" class="page-container py-12 md:py-16">
      <div class="mb-10 flex items-center justify-between border-b border-outline-variant/60 pb-6">
        <h2 class="section-title">ארכיון הפרקים</h2>
        <p class="label-marginalia text-on-surface-variant">{episodes.length} פרקים</p>
      </div>

      <div class="archive-grid">
        {
          rest.map((episode, index) => (
            <EpisodeArchiveCard episode={episode} variant={archiveCardVariant(index)} />
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
