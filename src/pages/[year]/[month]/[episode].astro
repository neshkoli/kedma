---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeHeader from '@/components/HomeHeader.astro';
import AudioPlayer from '@/components/AudioPlayer.astro';
import CusdisComments from '@/components/CusdisComments.astro';
import EpisodeDateDuration from '@/components/EpisodeDateDuration.astro';
import EpisodePlayButton from '@/components/EpisodePlayButton.astro';
import { episodeUrl, episodeSnippet, slugParts, type Episode } from '@/lib/episodes';
import { withBase } from '@/lib/paths';

export async function getStaticPaths() {
  const episodes = await getCollection('episodes');

  return episodes
    .map((episode) => {
      const parts = slugParts(episode.data.slug);
      if (!parts) return null;

      return {
        params: {
          year: parts.year,
          month: parts.month,
          episode: parts.file.replace(/\.html$/i, ''),
        },
        props: { episode },
      };
    })
    .filter(Boolean);
}

interface Props {
  episode: Episode;
}

const { episode } = Astro.props;
const { title, date, tags, image, imageCaption, audioUrl, periodName, slug, duration } = episode.data;
const { Content } = await render(episode);
const pageUrl = new URL(episodeUrl(episode), Astro.site).toString();
const { text: snippet } = episodeSnippet(episode, 300);
const description = snippet || `${title} - פודקאסט קדמא`;
const heroAlt = imageCaption ? '' : title;
---

<BaseLayout title={title} description={description} image={image}>
  <HomeHeader current="episodes" pinned />

  <main class="page-container py-8 pb-28 lg:py-12">
    <article>
      <header class="mb-5 space-y-3">
        <EpisodeDateDuration date={date} showDuration={false} />
        <h1 class="episode-title">{title}</h1>

        {audioUrl && <EpisodePlayButton duration={duration} />}

        <div class="flex flex-wrap gap-2">
          {
            periodName && (
              <a href={withBase('periods.html')} class="badge-period">
                {periodName}
              </a>
            )
          }
          {
            tags.map((tag) => (
              <a href={`${withBase('search.html')}?tag=${encodeURIComponent(tag)}`} class="badge-tag">
                {tag}
              </a>
            ))
          }
        </div>
      </header>

      <section class="episode-body">
        {
          image && (
            <figure class="episode-hero-figure">
              <img
                src={withBase(image)}
                alt={heroAlt}
                class="episode-hero-image"
              />
              {imageCaption && (
                <figcaption class="episode-hero-caption">
                  {imageCaption}
                </figcaption>
              )}
            </figure>
          )
        }

        <div class="prose-kedma">
          <Content />
        </div>
      </section>

      <CusdisComments pageId={slug} pageUrl={pageUrl} pageTitle={title} />
    </article>
  </main>

  {audioUrl && <AudioPlayer src={audioUrl} title={title} duration={duration} />}
</BaseLayout>
