---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeHeader from '@/components/HomeHeader.astro';
import { episodeUrl, episodesByPeriod, getEpisodes } from '@/lib/episodes';
import { withBase } from '@/lib/paths';

const episodes = await getEpisodes();
const periodEpisodes = episodes.filter((episode) => episode.data.period != null);
const eras = episodesByPeriod(periodEpisodes);
---

<BaseLayout title="תקופות" description="האזינו לפודקאסט קדמא לפי סדר תקופות היסטוריות">
  <HomeHeader current="periods" pinned />

  <main class="page-container py-8 lg:py-12">
    <header class="mb-10 border-b border-outline-variant/60 pb-6">
      <h1 class="section-title">תקופות בהיסטוריה</h1>
      <p class="mt-3 max-w-2xl font-body text-body-lg text-on-surface-variant">
        סדר כרונולוגי של פרקי הפודקאסט לפי תקופות היסטוריות
      </p>
    </header>

    {
      eras.size === 0 ? (
        <p class="rounded border border-dashed border-outline-variant p-6 text-on-surface-variant">
          עדיין לא הוגדרו תקופות. מלאו את <code class="text-ink-blue">migration/period-map.csv</code> והריצו שוב את
          המיגרציה.
        </p>
      ) : (
        <div class="periods-timeline">
          {[...eras.entries()].map(([eraName, eraEpisodes]) => (
            <section class="periods-era" aria-labelledby={`era-${eraName}`}>
              <h2 class="periods-era-title" id={`era-${eraName}`}>
                <span class="periods-era-dot" aria-hidden="true" />
                {eraName}
              </h2>
              <div class="periods-era-episodes">
                {eraEpisodes.map((episode) => {
                  const url = episodeUrl(episode);
                  const { title, image } = episode.data;
                  return (
                    <a href={url} class="periods-episode group">
                      {image ? (
                        <img
                          src={withBase(image)}
                          alt=""
                          class="timeline-thumb"
                          loading="lazy"
                        />
                      ) : (
                        <span class="timeline-thumb timeline-thumb-empty" aria-hidden="true" />
                      )}
                      <span class="min-w-0 flex-1 font-body text-body-lg font-medium text-ink-blue transition-colors group-hover:text-secondary">
                        {title}
                      </span>
                    </a>
                  );
                })}
              </div>
            </section>
          ))}
        </div>
      )
    }
  </main>
</BaseLayout>
