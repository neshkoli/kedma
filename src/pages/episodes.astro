---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeHeader from '@/components/HomeHeader.astro';
import {
  episodeUrl,
  episodesByYear,
  formatEpisodeDuration,
  formatHebrewDate,
  getEpisodes,
} from '@/lib/episodes';
import { withBase } from '@/lib/paths';

const episodes = await getEpisodes();
const years = episodesByYear(episodes);
---

<BaseLayout title="פרקים" description="כל פרקי הפודקאסט קדמא לפי סדר פרסום">
  <HomeHeader current="episodes" pinned />

  <main class="page-container py-8 lg:py-12">
    <header class="mb-10 border-b border-outline-variant/60 pb-6">
      <h1 class="section-title">פרקים</h1>
      <p class="mt-3 max-w-2xl font-body text-body-lg text-on-surface-variant">
        כל פרקי הפודקאסט לפי סדר פרסום, מהראשון לאחרון
      </p>
    </header>

    {
      years.size === 0 ? (
        <p class="rounded border border-dashed border-outline-variant p-6 text-on-surface-variant">
          עדיין לא פורסמו פרקים.
        </p>
      ) : (
        <div class="periods-timeline">
          {[...years.entries()].map(([year, yearEpisodes]) => (
            <section class="periods-era" aria-labelledby={`year-${year}`}>
              <h2 class="periods-era-title" id={`year-${year}`}>
                <span class="periods-era-dot" aria-hidden="true" />
                {year}
              </h2>
              <div class="periods-era-episodes">
                {yearEpisodes.map((episode) => {
                  const url = episodeUrl(episode);
                  const { title, image, date, duration } = episode.data;
                  return (
                    <a href={url} class="periods-episode group">
                      {image ? (
                        <img
                          src={withBase(image)}
                          alt=""
                          class="timeline-thumb"
                          loading="lazy"
                        />
                      ) : (
                        <span class="timeline-thumb timeline-thumb-empty" aria-hidden="true" />
                      )}
                      <span class="min-w-0 flex-1">
                        <span class="block font-body text-body-lg font-medium text-ink-blue transition-colors group-hover:text-secondary">
                          {title}
                        </span>
                        <span class="mt-1 block font-body text-label-sm text-on-surface-variant">
                          {formatHebrewDate(date)}
                          {duration ? ` · ${formatEpisodeDuration(duration)}` : ''}
                        </span>
                      </span>
                    </a>
                  );
                })}
              </div>
            </section>
          ))}
        </div>
      )
    }
  </main>
</BaseLayout>
