---
import '../styles/global.css';
import { withBase } from '@/lib/paths';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = 'קדמא - פודקאסט על היסטוריה יהודית עם נעם אשכולי', image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.url.origin);
const absoluteUrl = (path: string) => new URL(path, Astro.url.origin).toString();
const tamarFontUrl = withBase('fonts/EFT_Tamar.ttf');
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('favicon.ico')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600&family=Noto+Sans+Hebrew:wght@400;500;600&family=Noto+Serif+Hebrew:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <style set:html={`@font-face {
  font-family: 'EFT Tamar';
  src: url('${tamarFontUrl}') format('truetype');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}`}></style>
    <title>{title} | קדמא</title>
    <meta property="og:type" content="article" />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content="קדמא" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={absoluteUrl(withBase(image))} />}
    {image && <meta property="og:image:alt" content={title} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={absoluteUrl(withBase(image))} />}
  </head>
  <body class="min-h-screen">
    <slot />
  </body>
</html>
